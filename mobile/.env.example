# Copie para mobile/.env e use os mesmos valores de NEXT_PUBLIC_FIREBASE_* do site.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Endereço do AGIR que já sobe as fotos para o R2 e entrega o histórico.
# Emulador Android: http://10.0.2.2:3000
# Celular na mesma rede: http://IP-DA-MAQUINA:3000
EXPO_PUBLIC_AGIR_API_URL=

# Chave do Google Maps para o app Android publicado. No Expo Go o mapa pode abrir sem ela.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
