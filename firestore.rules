rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /agendaEvents/{eventId} {
      allow read, write: if request.auth != null;
    }
    match /socialPosts/{postId} {
      allow read, write: if request.auth != null;
    }
    match /appSettings/{docId} {
      allow read, write: if request.auth != null;
    }
    match /socialFollowerHistory/{docId} {
      allow read, write: if request.auth != null;
    }
    match /historyRecords/{recordId} {
      allow read, write: if request.auth != null;
    }
    match /galeriaSets/{setId} {
      allow read, write: if request.auth != null;
    }
    match /users/{userId} {
      // Qualquer utilizador autenticado lê perfis (lista para equipas / modais).
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }
    match /users/{userId}/dailyChecklistItems/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/dailyChecklistDay/{dateDoc} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /teamIntegrantes/{docId} {
      allow read, write: if request.auth != null;
    }
    match /emailInvites/{docId} {
      allow read, write: if request.auth != null;
    }
    match /customPontosViciados/{docId} {
      allow read, write: if request.auth != null;
    }
    match /diagnosticos/{diagnosticoId} {
      function validDiagnostic() {
        return request.resource.data.keys().hasAll(['schemaVersion', 'questionnaireVersion', 'kind', 'state', 'period', 'pointId', 'answers', 'photos', 'revision', 'createdByUid', 'updatedByUid'])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.kind in ['visita', 'trimestral']
          && request.resource.data.state in ['rascunho', 'concluido', 'importado']
          && request.resource.data.period.matches('^[0-9]{4}-T[1-4]$')
          && request.resource.data.pointId.matches('^[A-Z]{1,3}-[0-9]+$')
          && request.resource.data.answers is map
          && request.resource.data.answers.codigo == request.resource.data.pointId
          && request.resource.data.answers.endereco is string
          && request.resource.data.answers.endereco.size() > 0
          && request.resource.data.answers.dataChecagem.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.photos is list
          && request.resource.data.photos.size() <= 12
          && request.resource.data.updatedByUid == request.auth.uid;
      }
      allow read, delete: if request.auth != null;
      allow create: if request.auth != null && validDiagnostic()
        && request.resource.data.revision == 1 && request.resource.data.createdByUid == request.auth.uid;
      allow update: if request.auth != null && validDiagnostic()
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.createdByUid == resource.data.createdByUid;
    }
    match /solicitacoes/{docId} {
      // Criadas pelo bot via Admin SDK; a comunicação lê e muda o estado.
      allow read, write: if request.auth != null;
    }
    match /whatsappContacts/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // whatsappSessions, whatsappProcessedMessages e solicitacoesCounters ficam
    // sem regra: só o Admin SDK (webhook) os toca.
  }
}
